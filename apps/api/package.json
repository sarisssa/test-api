{
  "name": "api",
  "version": "0.1.0",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.846.0",
    "@aws-sdk/client-s3": "^3.899.0",
    "@aws-sdk/lib-dynamodb": "^3.846.0",
    "@fastify/auth": "^4.3.0",
    "@fastify/cors": "^8.4.1",
    "@fastify/env": "^4.3.0",
    "@fastify/jwt": "^7.2.4",
    "@fastify/multipart": "^8.3.1",
    "@fastify/redis": "^6.1.1",
    "@fastify/sensible": "^5.5.0",
    "@fastify/websocket": "^8.2.0",
    "ioredis": "^5.3.2",
    "@types/uuid": "^10.0.0",
    "dotenv": "^16.6.1",
    "fastify": "^4.29.1",
    "fastify-plugin": "^5.0.1",
    "tsx": "^4.20.3",
    "twilio": "^5.7.3",
    "uuid": "^11.1.0",
    "wage-shared": "*",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.6"
  },
  "type": "module",
  "scripts": {
    "start": "node dist/main.js",
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "postbuild": "mkdir -p dist/redis-scripts && cp src/redis-scripts/find-and-match-players.lua dist/redis-scripts/",
    "create-table": "node --loader ts-node/esm src/scripts/create-table.ts",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf dist",
    "seed-db": "node --loader ts-node/esm src/scripts/seed-db.ts",
    "seed-users": "tsx src/scripts/seed-users.ts",
    "seed-perks": "tsx src/scripts/seed-perks.ts",
    "create-in-progress-match": "tsx src/scripts/create-in-progress-match.ts",
    "create-partial-ready-match": "tsx src/scripts/create-partial-ready-match.ts",
    "create-test-players": "tsx src/scripts/create-test-players.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.24",
    "@types/ws": "^8.18.1",
    "eslint": "^9.29.0",
    "globals": "^16.2.0",
    "prettier": "3.5.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.34.1"
  }
}
