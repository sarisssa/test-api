# Core AWS configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Database / storage (LocalStack defaults)
DYNAMODB_URL=http://localhost:4566
WAGE_TABLE_NAME=WageTable
DYNAMODB_TABLE_NAME=WageTable
S3_BUCKET_NAME=local-bucket
S3_ENDPOINT=http://localhost:4566

# Authentication & secrets (replace in non-local envs)
JWT_SECRET=replace-me
PHONE_HASH_SALT=replace-me

# Redis
REDIS_URL=redis://127.0.0.1:6379
REDIS_TLS_REJECT_UNAUTHORIZED=false

# Twilio (stubbed for local usage)
TWILIO_ACCOUNT_SID=AC000000000000000000000
TWILIO_AUTH_TOKEN=dummy
TWILIO_VERIFY_SERVICE_SID=dummy
USE_TWILIO_STUB=true

# External services
TWELVE_DATA_API_KEY=replace-with-real-key
PRICE_STATUS_STALE_THRESHOLD_SECONDS=300
STEP_FUNCTIONS_ENDPOINT=http://localhost:4566
MATCH_SETTLEMENT_STATE_MACHINE_ARN=

# Optional Step Functions Lambda ARNs (enable full settlement workflow)
MATCH_COMPUTE_OUTCOME_FN_ARN=arn:aws:lambda:us-east-1:000000000000:function:match-compute-outcome
MATCH_AWARD_XP_FN_ARN=
MATCH_AWARD_CURRENCY_FN_ARN=
MATCH_NOTIFY_PAYMENTS_FN_ARN=
MATCH_EMIT_ANALYTICS_FN_ARN=
MATCH_BROADCAST_COMPLETION_FN_ARN=arn:aws:lambda:us-east-1:000000000000:function:match-broadcast-completion

# Gameplay guardrails (prod/cloud only)
# Percentage of match duration that must elapse before a player can forfeit.
# Effective only when NODE_ENV != development. Default is 0.1 (10%).
FORFEIT_GRACE_PERCENT=0.1

# Matchmaking guardrails (prod/cloud only)
# Maximum concurrent matches allowed per player. 0 disables the check.
# Set to 1 initially; raise to 3 when ready to support multi-match play.
MAX_CONCURRENT_MATCHES=0

# HTTP server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
