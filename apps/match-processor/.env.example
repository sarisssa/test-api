# Core AWS configuration
AWS_REGION=us-east-1
DYNAMODB_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# LocalStack / DynamoDB
USE_LOCALSTACK=true
LOCALSTACK_ENDPOINT=http://localhost:4566
DYNAMODB_ENDPOINT=http://localhost:4566
WAGE_TABLE_NAME=WageTable

# Market data / price caching
TWELVE_DATA_API_KEY=replace-with-real-key
USE_PRICE_SERVICE_STUB=false
PRICE_REQUEST_MIN_INTERVAL_MS=250
PRICE_CACHE_STRATEGY=dynamo
PRICE_CACHE_TTL_SECONDS=60
PRICE_CACHE_STALE_THRESHOLD_SECONDS=300

# Processor behaviour
IS_OFFLINE=true
MATCH_PROCESSOR_INTERVAL_SECONDS=30
